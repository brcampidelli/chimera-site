# Dropped into `_next/static/` by the deploy workflow.
#
# Everything under this directory is named by a hash of its own contents, so the name changes when
# the bytes change and the file can be cached until the heat death of the browser. Scoping the rule
# to this directory — rather than to `.js` and `.css` anywhere — is what keeps Pagefind's
# stable-named bundle out of it.

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
